class Solution(object):
    def letterCombinations(self, digits):
        if digits == "":
            return []

        s1 = []

        for i, x in enumerate(digits):
            s = []

            if x == "2":
                s.append("a")
                s.append("b")
                s.append("c")

            elif x == "3":
                s.append("d")
                s.append("e")
                s.append("f")

            elif x == "4":
                s.append("g")
                s.append("h")
                s.append("i")

            elif x == "5":
                s.append("j")
                s.append("k")
                s.append("l")

            elif x == "6":
                s.append("m")
                s.append("n")
                s.append("o")

            elif x == "7":
                s.append("p")
                s.append("q")
                s.append("r")
                s.append("s")

            elif x == "8":
                s.append("t")
                s.append("u")
                s.append("v")

            elif x == "9":
                s.append("w")
                s.append("x")
                s.append("y")
                s.append("z")

            s1.append(s)

        res = [""]

        for i, x in enumerate(s1):
            temp = []

            for y in res:
                for z in x:
                    temp.append(y + z)

            res = temp

        return res
